# --- Local MongoDB (default) ---
# Points at the mongod service on 127.0.0.1:27017.
MONGODB_URI=mongodb://127.0.0.1:27017/warong_ordering_system
MONGODB_DB=warong_ordering_system

# --- Or MongoDB Atlas ---
# Replace REPLACE_WITH_DB_PASSWORD with the database user's password.
# MONGODB_URI=mongodb+srv://maminruddinyahaya_db_user:REPLACE_WITH_DB_PASSWORD@cluster0.smbadnp.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Long random value that signs login sessions (rotating it logs everyone out).
AUTH_SECRET=
# Public base URL used in password-reset emails.
PORTAL_BASE_URL=http://localhost:3000
# Set to 1 when the portal is served over HTTPS so the session cookie is Secure.
AUTH_COOKIE_SECURE=

# --- Mailjet SMTP (password-reset email) ---
# API key is the SMTP username; the secret key is the SMTP password.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Must be a verified sender/domain in Mailjet.
MAIL_FROM=
MAIL_FROM_NAME=Warong Portal

# Legacy HTTP Basic auth (replaced by tenant logins; kept for reference).
PORTAL_USER=
PORTAL_PASSWORD=
